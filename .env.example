# Example environment variables for 3i-atlas-simulation
# Copy to .env and fill values locally (do NOT commit .env)

# Frontend origin (GitHub Pages or Vercel frontend)
FRONTEND_ORIGIN=https://<your-org>.github.io

# Vercel deployment URL (automatically set by Vercel)
VERCEL_URL=https://<your-vercel-deployment>.vercel.app

# For local development only
API_BASE_URL=http://127.0.0.1:8000

# GitHub Actions secrets (configure in repository settings)
# - No secrets needed for MPC data fetching (public astronomical data)
# - GitHub token automatically available as GITHUB_TOKEN

# Optional: Custom astronomical data parameters
EPHEMERIS_TARGET=0003I
EPHEMERIS_STEP=1h
EPHEMERIS_DAYS=60
