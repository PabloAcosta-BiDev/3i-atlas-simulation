# Example environment variables for 3i-atlas-simulation
# Copy to .env and fill values locally (do NOT commit .env)

# Frontend origin (GitHub Pages)
FRONTEND_ORIGIN=https://<your-org>.github.io

# Public Render URL for the backend
RENDER_URL=https://<your-render-service>.onrender.com

# Other environment variables (examples)
#SECRET_KEY=changeme
#DATABASE_URL=postgres://user:pass@host:port/dbname
